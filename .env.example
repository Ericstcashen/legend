# --- endpoints ---
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com
CHAIN_ID=137

# --- market discovery ---
# Gamma event tag slugs to scan (comma separated)
TAG_SLUGS=bitcoin
# Keywords a market question must contain when sweeping the most active markets
KEYWORDS=bitcoin,btc
MAX_GAMMA_PAGES=4

# --- book feed ---
# 1 = maintain live order books over the CLOB websocket (lowest latency);
# 0 = fetch books over REST each scan
USE_WEBSOCKET=0
WEBSOCKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# Books with no update in this many ms are treated as stale
BOOK_STALENESS_MS=5000

# --- strategy / risk ---
# Minimum edge per $1 redeemed, after fees (0.01 = 1%)
MIN_EDGE=0.01
# Skip opportunities with less total profit than this
MIN_PROFIT_USD=0.25
MAX_USD_PER_TRADE=100
MAX_DAILY_USD=500
# Drawdown fraction that halts live trading (0.1 = 10% below equity peak)
MAX_DRAWDOWN=0.1
SCAN_INTERVAL_MS=15000
# Act on the same opportunity at most once per window (ms)
COOLDOWN_MS=600000
# Where dry-run fills are recorded (JSONL)
PAPER_LEDGER=data/paper-trades.jsonl

# --- trading (only needed for LIVE=1) ---
LIVE=0
# 1 = refuse to place any live order; you can also `touch KILL` at runtime
KILL_SWITCH=0
# Polygon wallet private key that holds USDC and has CTF allowances approved
PK=
# CLOB L2 API credentials; leave blank to derive them from PK on startup
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
